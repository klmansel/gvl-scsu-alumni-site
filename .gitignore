.DS_Store
Thumbs.db
node_modules/
*.log

# Never commit a working copy of the private sheet or an exported roster.
*.csv
*.xlsx
private/

# Member portraits. These are real people's faces, and a commit is permanent:
# git keeps every blob forever, so "remove the photo" later means rewriting
# history. Keep them out of the repo and let the publisher manage them.
#
# NOTE: this only stops *local* commits. publish.gs writes photos through the
# GitHub Contents API, which does not consult .gitignore. If member photos
# should never be public at all, that is a repo-visibility decision, not a
# .gitignore one — see "Before you make the repo public" in README.md.
photos/*
!photos/.gitkeep
