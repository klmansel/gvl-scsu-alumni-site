.DS_Store
Thumbs.db
node_modules/
*.log

# Never commit a working copy of the private sheet or an exported roster.
*.csv
*.xlsx
private/

# Member portraits. Git blobs are permanent — keep local copies out of the
# repo and let publish.gs manage them via the GitHub API. This only stops
# *local* commits; the API path does not consult .gitignore. See README.md
# "Before you make the repo public" for the repo-visibility trade-offs.
photos/*
!photos/.gitkeep
